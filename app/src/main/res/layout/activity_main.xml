<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:sothree="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints"
        android:id="@+id/unityLayout">
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        sothree:layout_constraintStart_toStartOf="parent"
        sothree:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:layout_margin="5dp"
        >

        <!-- C app: (sothree:) не меняется цвет tint при смене темы -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/button_drawable"
            android:src="@drawable/settings_icon"
            android:layout_marginBottom="5dp"
            android:tint="?android:textColorPrimary"
            >
        </ImageButton>

        <LinearLayout
            android:id="@+id/langSettingsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/langButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="@string/lang_btn"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_RU"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="RU"
                android:visibility="gone"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_CN"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="CN"
                android:visibility="gone"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_EN"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/button_drawable"
                android:padding="5dp"
                android:text="EN"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:visibility="gone">
            </Button>
        </LinearLayout>

        <ImageButton
            android:id="@+id/themeButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/button_drawable"
            android:src="?android:src"
            android:tint="?android:textColorPrimary"
            android:visibility="gone"></ImageButton>

    </LinearLayout>

    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:id="@+id/slide_layout"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="450dp"
        android:gravity="bottom"
        android:background="#00000000"
        sothree:layout_constraintBottom_toBottomOf="parent"
        sothree:layout_constraintEnd_toEndOf="parent"
        sothree:layout_constraintHorizontal_bias="0.666"
        sothree:layout_constraintStart_toStartOf="parent"
        sothree:layout_constraintTop_toTopOf="parent"
        sothree:layout_constraintVertical_bias="0.652"
        sothree:overlay="false">

        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </View>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/panel_drawable"
            android:padding="16dp">

            <Spinner
                android:id="@+id/listBeginning"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@drawable/dropdown_list_background"
                android:layout_marginBottom="10dp"
                >

            </Spinner>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="90"
                android:src="@drawable/arrow_swap"
                android:tint="?android:textColorPrimary"
                android:layout_marginBottom="10dp"
                >
            </ImageView>

            <Spinner
                android:id="@+id/listEnding"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@drawable/dropdown_list_background"
                android:layout_marginBottom="30dp"
                >

            </Spinner>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/calculatePath"
                android:padding="15dp"
                android:text="Построить маршрут"
                android:background="@drawable/calc_path_button"
                >

            </Button>

        </LinearLayout>

    </com.sothree.slidinguppanel.SlidingUpPanelLayout>

</androidx.constraintlayout.widget.ConstraintLayout>