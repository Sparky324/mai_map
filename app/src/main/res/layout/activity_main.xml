<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:sothree="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    sothree:fadeColor="@android:color/holo_blue_light"
    sothree:overlay="false"
    sothree:panelHeight="68dp"
    sothree:shadowHeight="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        sothree:layout_constraintStart_toStartOf="parent"
        sothree:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:layout_margin="5dp"
        >

        <!-- C app: (sothree:) не меняется цвет tint при смене темы -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/button_drawable"
            android:src="@drawable/settings_icon"
            android:layout_marginBottom="5dp"
            android:tint="?android:textColorPrimary"
            >
        </ImageButton>

        <LinearLayout
            android:id="@+id/langSettingsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <Button
                android:id="@+id/langButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="@string/lang_btn"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_RU"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="RU"
                android:visibility="gone"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_CN"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/button_drawable"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:padding="5dp"
                android:text="CN"
                android:visibility="gone"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp">
            </Button>

            <Button
                android:id="@+id/langButton_EN"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/button_drawable"
                android:padding="5dp"
                android:text="EN"
                android:textColor="?android:textColorPrimary"
                android:textSize="25sp"
                android:visibility="gone">
            </Button>
        </LinearLayout>

        <ImageButton
            android:id="@+id/themeButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/button_drawable"
            android:src="?android:src"
            android:visibility="gone"
            android:tint="?android:textColorPrimary">
        </ImageButton>

    </LinearLayout>

